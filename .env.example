# ============================================================
#  SaidZen WiFi — Mfano wa Mipangilio ya Mazingira (.env)
#  Nakili faili hili liwe ".env" kisha ujaze taarifa zako.
# ============================================================

# ── DATABASE (LAZIMA) ───────────────────────────────────────
# Muundo: mysql://JINA_LA_MTUMIAJI:NENOSIRI@ANWANI:BANDARI/JINA_LA_DB
# Kama MySQL/MariaDB ipo kwenye seva hiyo hiyo:
DATABASE_URL=mysql://saidzen:nenosiri_lako@127.0.0.1:3306/saidzen_db

# KWA AIVEN CLOUD (managed MySQL) — tumia ssl-mode=REQUIRED:
# DATABASE_URL=mysql://USER:NENOSIRI@host:3306/saidzen_db

# ── USALAMA (Inapendekezwa kubadilisha) ─────────────────────
# Funguo ya kuficha nenosiri la router za MikroTik kwenye database.
# Badilisha hii iwe mfuatano mrefu wa siri.
ENCRYPTION_KEY=badilisha-funguo-hii-iwe-ya-siri-2026

# ── WIREGUARD VPN (LAZIMA kwa /connect command) ──────────────
# Funguo ya umma ya seva yako ya WireGuard.
# Ipate kwa: cat /etc/wireguard/server_public.key
WIREGUARD_SERVER_PUBLIC_KEY=weka_funguo_ya_uma_ya_seva_hapa

# IP ya umma ya seva yako (router zitatumia hii kuunganisha)
WIREGUARD_SERVER_ENDPOINT=IP_YA_SEVA_YAKO

# Bandari ya WireGuard (kawaida 51820)
WIREGUARD_PORT=51820

# Mtandao wa VPN (chaguo-msingi: 10.8.0.0/24)
WIREGUARD_SUBNET_PREFIX=10.8.0

# ── TOVUTI (LAZIMA kwa /connect na M-Pesa callback) ──────────
# Anwani kamili ya tovuti yako — router hutumia hii kujisajili
NEXT_PUBLIC_APP_URL=http://IP_YA_SEVA_YAKO:3000

# ── BANDARI (Hiari) ─────────────────────────────────────────
# Next.js hutumia bandari 3000 kwa chaguo-msingi.
# PORT=3000

# ── CRON JOBS (ULINZI — MUHIMU) ──────────────────────────────
# Funguo ya kulinda kazi za kiotomatiki. Bila hii, mtu yeyote anaweza
# kuzima huduma za wateja wako!
# Weka mfuatano mrefu wa siri, kisha itumie kwenye crontab:
#   0 0 * * * curl -s -H "x-cron-secret: FUNGUO_YAKO" http://localhost:3000/api/cron/check-payments
CRON_SECRET=badilisha-hii-iwe-funguo-ya-siri-ndefu

# ── HALI YA MIKROTIK ─────────────────────────────────────────
# false (chaguo-msingi) = inaongea na router HALISI; router ikiwa haipo,
#        mfumo unasema ukweli (hakuna vocha za uongo).
# true  = majaribio BILA router (kila jibu limeandikwa "simulation").
#        USITUMIE kwenye uzalishaji!
MIKROTIK_SIMULATION=false
